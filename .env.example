# ─────────────────────────────────────────────
# LoanForge API — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in the values
# cp .env.example .env

# ── Server ──────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ────────────────────────────────
DATABASE_URL=postgresql://loanforge:loanforge_secret@localhost:5432/loanforge_db

# ── Redis ───────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ─────────────────────────────────────
JWT_ACCESS_SECRET=your-super-secret-access-key-change-this-in-production-64chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-64chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Bcrypt ──────────────────────────────────
BCRYPT_ROUNDS=12

# ── Email (SMTP) ────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="LoanForge <noreply@loanforge.com>"

# ── File Uploads ────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ── Frontend URL (for CORS) ─────────────────
FRONTEND_URL=http://localhost:5173

# ── Rate Limiting ───────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# ── App ─────────────────────────────────────
APP_NAME=LoanForge
APP_URL=http://localhost:3000
